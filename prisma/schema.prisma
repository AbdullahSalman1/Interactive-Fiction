// Prisma 7: NO "url" in the datasource block. The url is in prisma.config.mjs.
// After every change to this file run:  npm run db:migrate
// (it asks for a migration name, e.g. "init", "add-playthrough")

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// STEP 4 (STEPS.md) - you write the fields. Hints are in the comments.
// ---------------------------------------------------------------------------

model Story {
  id           Int      @id @default(autoincrement())
  title        String
  summary      String   @default("")
  published    Boolean  @default(false)
  createdAt    DateTime @default(now())

  scenes       Scene[]  @relation("StoryScenes")

  startSceneId Int?     @unique
  startScene   Scene?   @relation("StoryStart", fields: [startSceneId], references: [id], onDelete: SetNull)
}


model Scene {
  id         Int      @id @default(autoincrement())
  title      String
  body       String   @default("")
  isEnding   Boolean  @default(false)

  storyId    Int
  story      Story    @relation("StoryScenes", fields: [storyId], references: [id], onDelete: Cascade)

  startOf    Story?   @relation("StoryStart")

  choicesOut Choice[] @relation("ChoiceFrom")
  choicesIn  Choice[] @relation("ChoiceTo")
}

model Choice {
  id          Int    @id @default(autoincrement())
  label       String

  fromSceneId Int
  fromScene   Scene  @relation("ChoiceFrom", fields: [fromSceneId], references: [id], onDelete: Cascade)

  toSceneId   Int
  toScene     Scene  @relation("ChoiceTo", fields: [toSceneId], references: [id], onDelete: Cascade)
}

